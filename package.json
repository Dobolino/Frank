{
  "name": "frank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lokale Finanz-, Budget- und Steuer-App für die Schweiz",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "update-tax": "node scripts/update-tax-data.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "wasm-feature-detect": "1.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
